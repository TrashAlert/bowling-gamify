{
  "name": "@bowling-rpg/api",
  "version": "0.1.0",
  "private": true,
  "description": "Fastify + tRPC API. Routers are thin, services hold the rules, repositories hold the SQL.",
  "type": "module",
  "exports": {
    "./router": "./src/routers/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@bowling-rpg/contracts": "workspace:*",
    "@bowling-rpg/db": "workspace:*",
    "@bowling-rpg/scoring": "workspace:*",
    "@trpc/server": "^11.6.0",
    "drizzle-orm": "^0.45.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "postgres": "^3.4.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
